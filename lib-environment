#!/bin/bash
# Shared environment detection for linux-bash-tweaks. Meant to be sourced
# (not executed) by bashrc-additions and configure-yubikey.
#
# Populates LBT_IS_WSL, LBT_WIN_USERPROFILE, and LBT_WIN_LOCALAPPDATA. The
# result is cached in ~/.config/linux-bash-tweaks/env so the cmd.exe/wslpath
# calls needed to resolve them only run once instead of on every new shell.
# Delete that file to force re-detection (e.g. after moving this distro to a
# different Windows account).

LBT_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linux-bash-tweaks"
LBT_ENV_CACHE="$LBT_CONFIG_DIR/env"

if [ -f "$LBT_ENV_CACHE" ]; then
    source "$LBT_ENV_CACHE"
fi

if [ -z "$LBT_IS_WSL" ]; then
    if grep -qi microsoft /proc/version 2>/dev/null; then
        LBT_IS_WSL=1
        win_userprofile="$(cmd.exe /C "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')"
        LBT_WIN_USERPROFILE="$(wslpath -u "$win_userprofile" 2>/dev/null)"
        LBT_WIN_LOCALAPPDATA="$LBT_WIN_USERPROFILE/AppData/Local"
        unset win_userprofile
    else
        LBT_IS_WSL=0
        LBT_WIN_USERPROFILE=""
        LBT_WIN_LOCALAPPDATA=""
    fi

    mkdir -p "$LBT_CONFIG_DIR"
    cat > "$LBT_ENV_CACHE" <<EOF
# Auto-generated by linux-bash-tweaks. Delete this file to force re-detection.
LBT_IS_WSL=$LBT_IS_WSL
LBT_WIN_USERPROFILE="$LBT_WIN_USERPROFILE"
LBT_WIN_LOCALAPPDATA="$LBT_WIN_LOCALAPPDATA"
EOF
fi

# User-managed settings, distinct from the auto-generated env cache above. Holds
# the optional dotfiles-sync knobs (LBT_DOTFILES_REPO, LBT_DOTFILES_TOKEN); see
# lib-release and the README.
LBT_CONFIG_FILE="$LBT_CONFIG_DIR/config"
if [ -f "$LBT_CONFIG_FILE" ]; then
    source "$LBT_CONFIG_FILE"
fi

# The maintainer's own accounts default to syncing the private dotfiles repo;
# everyone else leaves LBT_DOTFILES_REPO unset and the feature stays inert.
if [ -z "$LBT_DOTFILES_REPO" ] && [ "$(id -un)" = "randy" ]; then
    LBT_DOTFILES_REPO="flyguy62n/dotfiles"
fi

export LBT_IS_WSL LBT_WIN_USERPROFILE LBT_WIN_LOCALAPPDATA
export LBT_CONFIG_DIR LBT_DOTFILES_REPO LBT_DOTFILES_TOKEN
