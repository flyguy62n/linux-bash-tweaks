#!/bin/bash

#Update all APT packages
sudo apt-get update && sudo apt-get -y dist-upgrade

# This script is fetched and run standalone (see README), before the rest of
# the repo — including lib-environment — exists on disk, so WSL detection is
# duplicated here rather than sourced.
lbt_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/linux-bash-tweaks"
mkdir -p "$lbt_config_dir"

# Only wire up Windows-side steps (symlinks, YubiKey packages) when actually
# running under WSL, so this script can also be run cleanly on plain Ubuntu
# boxes. /proc/version on a WSL kernel contains "microsoft".
if grep -qi microsoft /proc/version 2>/dev/null; then
    is_wsl=1
else
    is_wsl=0
fi

if [ "$is_wsl" = "1" ]; then
    # Auto-resolve the Windows user's profile directory: ask cmd.exe for
    # %USERPROFILE%, then use wslpath so it maps to wherever C: is actually
    # mounted (normally /mnt/c, but not guaranteed).
    win_userprofile="$(cmd.exe /C "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')"
    windows_user_dir="$(wslpath -u "$win_userprofile" 2>/dev/null)"

    # Fall back to prompting if auto-detection didn't produce a real directory.
    while ! [ -d "$windows_user_dir" ]; do
        ls -1d /mnt/c/Users/*/
        read -p "Enter your Windows Users directory (e.g., /mnt/c/Users/YourUsername): " windows_user_dir
        if ! [ -d "$windows_user_dir" ]; then
            echo "Directory $windows_user_dir does not exist. Please try again."
        fi
    done

    # Prime the shared detection cache (see lib-environment) so bashrc-additions
    # doesn't need to re-run cmd.exe on every future shell startup.
    cat > "$lbt_config_dir/env" <<EOF
# Auto-generated by linux-bash-tweaks. Delete this file to force re-detection.
LBT_IS_WSL=1
LBT_WIN_USERPROFILE="$windows_user_dir"
LBT_WIN_LOCALAPPDATA="$windows_user_dir/AppData/Local"
EOF

    cd ~
    # Create symlinks to some useful Windows user directories
    win_user_dirs=(
        "Desktop"
        "Documents"
        "Downloads"
        "OneDrive"
    )
    for dir in "${win_user_dirs[@]}"; do
        if [ -d "${windows_user_dir}/${dir}" ]; then
            echo "Creating symlink for ${dir}..."
            ln -s "${windows_user_dir}/${dir}"
        else
            echo "Directory ${windows_user_dir}/${dir} does not exist. Skipping..."
            continue
        fi
    done
else
    echo "Not running under WSL. Skipping Windows user directory symlinks..."
    cat > "$lbt_config_dir/env" <<EOF
# Auto-generated by linux-bash-tweaks. Delete this file to force re-detection.
LBT_IS_WSL=0
LBT_WIN_USERPROFILE=""
LBT_WIN_LOCALAPPDATA=""
EOF
fi

tools_dir="${HOME}/tools"
mkdir ${tools_dir}

# Clone some repositories into ~/tools
cd ${tools_dir}
git clone https://github.com/drwetter/testssl.sh

############################################
######## INSTALL ADDITIONAL STUFF ##########
############################################

#Install pdftotext utils. These are useful for doing text searches on docs provided to you
#as PDFs.

sudo apt-get -y install poppler-utils

#UV is a fast, all-in-one Python package/tool manager (a modern replacement for
#pip/pipx). We use it to install a few standalone Python-based CLI tools; it
#manages its own Python runtimes, so no system Python/pip install is needed.

curl -LsSf https://astral.sh/uv/install.sh | sh
# uv installs itself to ~/.local/bin; source its env file so it's usable for
# the rest of this script too (future shells already get ~/.local/bin from
# bashrc-additions' PATH export).
source "${HOME}/.local/bin/env"

# Install SSH-Audit using UV
uv tool install ssh-audit

#Install some more handy things
# zip and p7zip - File compression utilities
# Fortune - Random sayings and quotes for a little login fun
# Cowsay - ASCII-art cow (and other characters). Used with Fortune for a little login fun
# Dos2Unix - Convert files between DOS (CRLF) and Unix (LF) formats. A true necessity in a cross-platform world

sudo apt-get -y install zip p7zip fortune cowsay dos2unix

# Socat and SCDaemon -- Utilities needed for YubiKey/WSL support. Only relevant under WSL.
if [ "$is_wsl" = "1" ]; then
    sudo apt-get -y install socat scdaemon
fi

# On WSL distros with systemd enabled, systemd's own gpg-agent socket units
# compete with the socat-based YubiKey bridge configure-yubikey sets up --
# both want to own the same socket path. Mask and stop them so systemd never
# manages (or re-creates) them.
#
# /run/systemd/system only exists while systemd is actually running as PID 1.
# That's a more reliable signal than reading /etc/wsl.conf's systemd=true,
# since the config file only reflects configured intent and doesn't take
# effect until the WSL instance is restarted.
if [ "$is_wsl" = "1" ] && [ -d /run/systemd/system ] && command -v systemctl &>/dev/null; then
    echo "Masking systemd-managed gpg-agent sockets..."
    gpg_agent_sockets=(gpg-agent.socket gpg-agent-ssh.socket gpg-agent-extra.socket gpg-agent-browser.socket)
    systemctl --user mask "${gpg_agent_sockets[@]}"
    systemctl --user stop "${gpg_agent_sockets[@]}"
    rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gnupg/S.gpg-agent"*
    unset gpg_agent_sockets
fi

# Add linux-bash-tweaks to the system
if [ -z "$(grep get_latest_bash_tweaks ${HOME}/.bashrc)" ]; then
    echo "Adding linux-bash-tweaks to .bashrc..."
else
    echo "linux-bash-tweaks already in .bashrc. Skipping..."
fi
cat <<EOF >> ${HOME}/.bashrc

########################
#BEGIN .bashrc CHANGES #
########################

# function to retrieve the latest linux-bash-tweaks release from GitHub
function get_latest_bash_tweaks() {
    # Get the latest release from the GitHub API
    local install_path="\${HOME}/tools/linux-bash-tweaks"
    local latest_release=\$(curl -s https://api.github.com/repos/flyguy62n/linux-bash-tweaks/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")')
    local current_version=\$(cat \${install_path}/version 2>/dev/null)
    
    # Check if the latest release is not empty
    if [ -z "\$latest_release" ]; then
        echo "Bash Tweaks Error: Unable to retrieve the latest release."
        return 1
    fi
    
    # Make sure the intall path exists
    if [ ! -d "\$install_path" ]; then
        mkdir -p "\$install_path"
        if [ \$? -ne 0 ]; then
            echo "Bash Tweaks Error: Unable to create install path: \$install_path"
            return 1
        fi
    fi

    if [ "\$latest_release" == "\$current_version" ]; then
        echo "Latest Bash Tweaks already installed: \$current_version"
        return 0
    fi

    # Fetch the latest release from GitHub
    echo "Fetching latest Bash Tweaks release from GitHub..."
    curl -s -L ""

    local fetch_url="\$(curl -s https://api.github.com/repos/flyguy62n/linux-bash-tweaks/releases/latest \
        | grep "tarball_url" \
        | awk '{ print \$2 }' \
        | sed 's/,$//'       \
        | sed 's/"//g' )"
        
    # Download the latest release
    curl -s -L "\$fetch_url" -o \${install_path}/latest.tar.gz
    if [ \$? -ne 0 ]; then
        echo "Bash Tweaks Error: Unable to download the latest release: \$fetch_url"
        return 1
    fi

    # Unzip the latest release
    tar xzvf \${install_path}/latest.tar.gz --strip-components=1 -C \${install_path}/ 1>/dev/null
    if [ \$? -ne 0 ]; then
        echo "Bash Tweaks Error: Unable to extract the latest release."
        return 1
    fi

    # Update the version marker file
    echo "\$latest_release" > \${install_path}/version
    
    # Set the executable bit on any .sh files in the recently updated tool
    chmod -R u+x \${install_path}/*.sh 2>/dev/null

    # Print the latest release
    echo "Installed release: \$latest_release"
}

# Fetch the latest release of linux-bash-tweaks
get_latest_bash_tweaks

# Check if the bashrc-additions file exists
if [ -f "\${HOME}/tools/linux-bash-tweaks/bashrc-additions" ]; then
    source \${HOME}/tools/linux-bash-tweaks/bashrc-additions
else
    echo "Bash Tweaks Error: Unable to find bashrc-additions file."
    return 1
fi

cd ~
EOF

############################################
################ ALL DONE ##################
############################################

echo "Your WSL environment is set up now.  Restart your shell prompt."

