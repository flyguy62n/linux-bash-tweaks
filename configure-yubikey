#!/bin/bash

########################################
##########Yubikey WSL Support###########
########################################
# Abbreviated instructions: https://github.com/flyguy62n/misc-public
# See https://jardazivny.medium.com/the-ultimate-guide-to-yubikey-on-wsl2-part-1-dce2ff8d7e45
# for the rest of the instructions
# SSH Socket

echo "Setting up YubiKey SSH and GPG agent sockets for WSL2..."

export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
if ! ss -a | grep -q "$SSH_AUTH_SOCK"; then
    rm -f "$SSH_AUTH_SOCK"
    wsl2_ssh_pageant_bin="$HOME/.ssh/wsl2-ssh-pageant.exe"
        if test -x "$wsl2_ssh_pageant_bin"; then
            (setsid nohup socat UNIX-LISTEN:"$SSH_AUTH_SOCK,fork" EXEC:"$wsl2_ssh_pageant_bin" >/dev/null 2>&1 &)
            echo "YubiKey SSH_AUTH_SOCK: $SSH_AUTH_SOCK"
        else
            echo >&2 "WARNING: $wsl2_ssh_pageant_bin is not executable."
        fi
    unset wsl2_ssh_pageant_bin
fi
# GPG Socket
export GPG_AGENT_SOCK="$(gpgconf --list-dirs agent-socket)"
if ! ss -a | grep -q "$GPG_AGENT_SOCK"; then
    rm -rf "$GPG_AGENT_SOCK"
    wsl2_ssh_pageant_bin="$HOME/.ssh/wsl2-ssh-pageant.exe"
    # Ask Windows for the current user's LOCALAPPDATA (e.g. C:\Users\RJBar\AppData\Local);
    # cmd.exe echoes CRLF, so strip the trailing \r.
    win_localappdata="$(cmd.exe /C "echo %LOCALAPPDATA%" 2>/dev/null | tr -d '\r')"
    # wsl2-ssh-pageant.exe wants a Windows path but with forward slashes...
    config_path="${win_localappdata//\\//}"
    # ...and the drive-letter colon backslash-escaped, since socat's EXEC:"..."
    # address parsing treats a bare ":" as a field separator.
    config_path="${config_path/:/\\:}/gnupg"
        if test -x "$wsl2_ssh_pageant_bin"; then
            (setsid nohup socat UNIX-LISTEN:"$GPG_AGENT_SOCK,fork" EXEC:"$wsl2_ssh_pageant_bin -gpgConfigBasepath ${config_path} -gpg S.gpg-agent" >/dev/null 2>&1 &)
            echo "YubiKey GPG_AGENT_SOCK: $GPG_AGENT_SOCK"
        else
            echo >&2 "WARNING: $wsl2_ssh_pageant_bin is not executable."
        fi
    unset wsl2_ssh_pageant_bin
fi
########################################
########END Yubikey WSL Support#########
########################################